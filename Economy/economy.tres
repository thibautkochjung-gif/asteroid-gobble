[sub_resource type="Resource" id="Field_near"]
script = ExtResource("2_field")
description = "Close to the ring. Small rocks, mostly ice and nickel-iron. Cheap and quiet."
ores_hint = "Water ice, nickel-iron"
profile = ExtResource("4_belt")
world_seed = 101

[sub_resource type="Resource" id="Field_cobalt"]
script = ExtResource("2_field")
display_name = "Cobalt reach"
description = "A day out. Bigger rocks, cobalt in the clusters."
ores_hint = "Nickel-iron, cobalt"
drop_fee = 500
profile = ExtResource("4_belt")
world_seed = 202

[sub_resource type="Resource" id="Field_drift"]
script = ExtResource("2_field")
display_name = "Deep drift"
description = "Far out. Gold turns up in the big rocks."
ores_hint = "Cobalt, gold"
licence_tier = 2
drop_fee = 1200
profile = ExtResource("4_belt")
world_seed = 303

[sub_resource type="Resource" id="Field_shoals"]
script = ExtResource("2_field")
display_name = "Outer shoals"
description = "The edge of the belt. Platinum, and nobody to call for help."
ores_hint = "Gold, platinum"
licence_tier = 3
drop_fee = 3000
profile = ExtResource("4_belt")
world_seed = 404

[sub_resource type="Resource" id="Insurance_none"]
script = ExtResource("3_insurance")
description = "Lose the ship, lose everything."

[sub_resource type="Resource" id="Insurance_basic"]
script = ExtResource("3_insurance")
display_name = "Basic"
description = "Pays back half the hull."
premium_ratio = 0.03
payout_ratio = 0.5

[sub_resource type="Resource" id="Insurance_full"]
script = ExtResource("3_insurance")
display_name = "Full"
description = "Pays back 90% of the hull and the modules."
premium_ratio = 0.07
payout_ratio = 0.9
covers_modules = true

[sub_resource type="Resource" id="Hull_bucket"]
script = ExtResource("5_hull")
id = &"bucket"
display_name = "The Bucket"
description = "Industrial, rugged, a bit shabby. Turns unevenly."
scene_path = "res://Ship/Hulls/bucket.tscn"
price = 8000

