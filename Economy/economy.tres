[ext_resource type="Script" uid="uid://bhs61mylf25uo" path="res://Economy/hull_definition.gd" id="5_hull"]

[sub_resource type="Resource" id="Hull_bucket"]
script = ExtResource("5_hull")
description = "Industrial, rugged, a bit shabby. Turns unevenly."
scene_path = "res://Ship/Hulls/bucket.tscn"

[sub_resource type="Resource" id="Hull_commuter"]
script = ExtResource("5_hull")
id = &"commuter"
display_name = "Meridian Commuter"
description = "Meridian's mid-range miner. Clean, balanced, no handling quirks. Four big rooms, two hardpoints, a wider mouth than the Bucket and a built-in trim computer."
scene_path = "res://Ship/Hulls/meridian.tscn"
price = 27000
integrated_computer = true

[sub_resource type="Resource" id="Hull_crab"]
script = ExtResource("5_hull")
id = &"crab"
display_name = "The Crab"
description = "Army surplus manipulator. A wide flat slab with a big hold, four hardpoints across the nose and wingtip jets: it turns and strafes like a much smaller ship."
scene_path = "res://Ship/Hulls/crab.tscn"
price = 52000

[sub_resource type="Resource" id="Hull_harvester"]
script = ExtResource("5_hull")
id = &"harvester"
display_name = "Meridian Harvester"
description = "Meridian's long-haul processor, built to stay out for a long time. The flash smelter in the front drum comes with the hull and two big ingot holds sit in the drums behind it. Wide hammer head with a big mouth, four forward hardpoints, six soft points and a built-in trim computer. Slow to turn once the holds fill up."
scene_path = "res://Ship/Hulls/meridian_harvester.tscn"
price = 110000
integrated_computer = true

[sub_resource type="Resource" id="Insurance_none"]
script = ExtResource("3_insurance")
description = "Lose the ship, lose everything."

[sub_resource type="Resource" id="Insurance_basic"]
script = ExtResource("3_insurance")
display_name = "Basic"
description = "Pays back half the hull."
premium_ratio = 0.03
payout_ratio = 0.5

[sub_resource type="Resource" id="Insurance_full"]
script = ExtResource("3_insurance")
display_name = "Full"
description = "Pays back 90% of the hull and the modules."
premium_ratio = 0.07
payout_ratio = 0.9
covers_modules = true

